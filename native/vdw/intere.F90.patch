+#ifdef MUTABIND2_VDW_AUDIT
+subroutine MB_AUDIT_INTS(label,n,values)
+  use iso_c_binding
+  use stream,only:OUTU
+  implicit none
+  character(len=*),intent(in) :: label
+  integer,intent(in) :: n
+  integer(c_int),target,intent(in) :: values(*)
+  integer(c_int8_t),target :: md(32)
+  type(c_ptr) :: result,data
+  integer :: i
+  interface
+     function sha256(data,nbytes,md) bind(c,name='SHA256') result(p)
+       import c_ptr,c_size_t
+       type(c_ptr),value :: data,md
+       integer(c_size_t),value :: nbytes
+       type(c_ptr) :: p
+     end function sha256
+  end interface
+  if(n<0) error stop 'negative audit size'
+  data=c_null_ptr
+  if(n>0) data=c_loc(values(1))
+  result=sha256(data,int(n,c_size_t)*c_sizeof(values(1)),c_loc(md(1)))
+  if(.not.c_associated(result)) error stop 'SHA256 failed'
+  write(OUTU,'(A,1X,A,1X,I0,1X,32(Z2.2))') ' MBVDW_SHA256',trim(label),n, &
+       (iand(int(md(i)),255),i=1,32)
+end subroutine MB_AUDIT_INTS
+#endif
+
+#ifdef MUTABIND2_VDW_AUDIT
+subroutine MB_AUDIT_REALS(label,n,values)
+  use iso_c_binding
+  use stream,only:OUTU
+  implicit none
+  character(len=*),intent(in) :: label
+  integer,intent(in) :: n
+  real(c_double),target,intent(in) :: values(*)
+  integer(c_int8_t),target :: md(32)
+  type(c_ptr) :: result,data
+  integer :: i
+  interface
+     function sha256(data,nbytes,md) bind(c,name='SHA256') result(p)
+       import c_ptr,c_size_t
+       type(c_ptr),value :: data,md
+       integer(c_size_t),value :: nbytes
+       type(c_ptr) :: p
+     end function sha256
+  end interface
+  if(n<0) error stop 'negative audit size'
+  data=c_null_ptr
+  if(n>0) data=c_loc(values(1))
+  result=sha256(data,int(n,c_size_t)*c_sizeof(values(1)),c_loc(md(1)))
+  if(.not.c_associated(result)) error stop 'SHA256 failed'
+  write(OUTU,'(A,1X,A,1X,I0,1X,32(Z2.2))') ' MBVDW_SHA256',trim(label),n, &
+       (iand(int(md(i)),255),i=1,32)
+end subroutine MB_AUDIT_REALS
+#endif
