   real(chm_real)  X(*),Y(*),Z(*)
@@ -257,6 +276,61 @@
 #undef KEY_EXPAND
 #endif
 
+  call get_environment_variable('MUTABIND2_VDW_GPU',mb_env,length=mb_env_length,status=mb_env_status)
+  mb_dense=mb_env_status==0.and.mb_env_length==1.and.mb_env=='1'
